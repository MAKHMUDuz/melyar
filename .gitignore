# Rust / Cargo
target/
build/
build-release/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# cxx-bridge generated headers (regenerated by core_rs/build.rs)
core_rs/include/melyar_core/

