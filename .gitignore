third_party/

# Logs
*.log

# Debian packaging
debian/.debhelper
debian/files
debian/melyar.debhelper.log
debian/melyar.substvars
debian/*.debhelper.log

# makepkg / packaging artifacts (a package is built in a clean tree, never
# committed next to the sources)
# makepkg artefacts: anchored to the repository root, because a bare "src/"
# would also hide ui_web/src/ from git and from Tailwind's content scan,
# which silently changes the built CSS bundle.
/pkg/
/src/
*.pkg.tar.zst
*.deb
*.spec
.SRCINFO
data.tar.gz
arch_pkg/
debian_pkg/

# Node / web UI
ui_web/node_modules/

# Editor / OS
.DS_Store
*.swp
